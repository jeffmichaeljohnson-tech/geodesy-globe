{
  "name": "geodesy-globe",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Geodetic maths and camera-flight logic for a real-scale Earth globe: WGS84, ECEF, float64 origin rebasing, great-circle arcs, and the framing maths behind a fly-to.",
  "keywords": [
    "geodesy",
    "wgs84",
    "ecef",
    "great-circle",
    "globe",
    "three"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./math": "./src/geodesyMath.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutation": "node scripts/mutation-runner.mjs . mutations.json",
    "test:mutation-runner": "node scripts/mutation-runner.test.mjs"
  },
  "peerDependencies": {
    "three": ">=0.170"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.185.0",
    "three": "^0.185.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
