{
  "name": "geodesy-globe",
  "version": "0.1.0",
  "type": "module",
  "description": "Geodetic maths and camera-flight logic for a real-scale Earth globe: WGS84, ECEF, float64 origin rebasing, great-circle arcs, and the framing maths behind a fly-to.",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutation": "node scripts/mutation-runner.mjs . mutations.json",
    "test:mutation-runner": "node scripts/mutation-runner.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.185.0",
    "three": "^0.185.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "three": ">=0.170"
  },
  "exports": {
    ".": "./src/index.ts",
    "./math": "./src/geodesyMath.ts"
  },
  "types": "./src/index.ts",
  "engines": {
    "node": ">=20"
  }
}
